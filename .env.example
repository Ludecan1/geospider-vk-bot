# Токен сообщества VK (см. README)
VK_GROUP_TOKEN=ваш_ключ_сообщества
# Числовой id группы (из адреса club123 → 123)
VK_GROUP_ID=238890367

# Сразу только опрос диалогов (без Long Poll), если хост Long Poll недоступен по DNS/VPN
# VK_INCOMING_POLL_ONLY=1

# Опрос API (как у Telegram-бота)
POLL_INTERVAL_SECONDS=30
# Центр — Великий Новгород (кремль); радиус отбора станций, км
CENTER_LAT=58.5213
CENTER_LON=31.2755
RADIUS_KM=75
GEOSPIDER_API_URL=https://api.geospider.ru/geospider/SitesInfo.asmx/GetAllSites
