# Скопируйте эти переменные в панель Bothost → ваш бот → Переменные окружения.
# Файл .env в Git не кладите — только секреты в панели хостинга.

# Bothost также подставляет токен в BOT_TOKEN — бот подхватит его автоматически.
# Если задаёте оба, VK_GROUP_TOKEN не должен быть короче BOT_TOKEN (обрезка в панели).
VK_GROUP_TOKEN=ваш_ключ_сообщества
VK_GROUP_ID=238890367

# Опционально: peer_id через запятую (если data/subscribers.json пуст на сервере)
SUBSCRIBER_IDS=30068273,143527582

POLL_INTERVAL_SECONDS=60
CENTER_LAT=58.5213
CENTER_LON=31.2755
RADIUS_KM=75

# На хостинге Long Poll иногда недоступен по DNS — можно сразу включить опрос диалогов:
# VK_INCOMING_POLL_ONLY=1

GEOSPIDER_API_URL=https://api.geospider.ru/geospider/SitesInfo.asmx/GetAllSites
